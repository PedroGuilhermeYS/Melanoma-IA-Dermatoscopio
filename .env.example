# Copy this file to .env and adjust for your deployment / experiment. Loaded automatically by the CLI, API and orchestrator via python-dotenv where applicable.

# Model
MELANOMA_MODEL_NAME=eva02_small_patch14_336.mim_in22k_ft_in1k
MELANOMA_HF_REPO_ID=fawo/eva02-small-melanoma-classifier
MELANOMA_HF_FILENAME=model_0001.pt

# Pin this to a commit SHA or tag before any run whose results you intend to cite/publish. Otherwise the model can silently change if the upstream Hugging Face repo is updated. Leave empty only for quick local experiments.
MELANOMA_HF_REVISION=

# Decision threshold. See results/threshold_key_indicators.csv for the other candidate operating points (Youden's J, 95%/99% sensitivity, 80% specificity) and how each was derived. 0.430 matches ~97% sensitivity.
MELANOMA_THRESHOLD=0.430

# "auto" picks CUDA if available, else CPU.
MELANOMA_DEVICE=auto

# API server (melanoma_ia.api)
MELANOMA_API_HOST=0.0.0.0
MELANOMA_API_PORT=8000
MELANOMA_API_LOG_LEVEL=info
# Shared secret required as Authorization: Bearer <token> on /predict and /predict/gradcam. Leave empty to disable auth.
MELANOMA_API_TOKEN=

# Orchestrator (melanoma_ia.pipeline.orchestrator)
# URL of the camera service's Flask app (raspberry-pi-camera-web repo).
MELANOMA_CAMERA_URL=http://192.168.1.50:5000
# Must match CAMERA_API_TOKEN in the camera repo's .env, if that's set.
MELANOMA_CAMERA_TOKEN=

# Not currently used by the orchestrator directly, kept for a future deployment where the orchestrator instead calls a remote API server over HTTP.
MELANOMA_API_URL=http://127.0.0.1:8000

MELANOMA_POLL_INTERVAL_SECONDS=2
MELANOMA_BATCH_SIZE=10
MELANOMA_RESULTS_PATH=results/orchestrator_log.jsonl
